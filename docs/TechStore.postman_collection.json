{
  "info": {
    "name": "TechStore API",
    "description": "Colección de endpoints de TechStore. Ejecuta primero **Auth > Login admin**: guarda el token en la variable `adminToken` automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "reviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nuevo Usuario\",\n  \"email\": \"nuevo@techstore.com\",\n  \"password\": \"Password1\"\n}" },
            "description": "Crea una cuenta con rol `user`. La contraseña requiere 8+ caracteres, una mayúscula y un número. Respuestas: 201, 400 (validación), 409 (correo duplicado)."
          }
        },
        {
          "name": "Login admin",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@techstore.com\",\n  \"password\": \"Admin123!\"\n}" },
            "description": "Devuelve `{ user, token }`. El JWT incluye `sub`, `role` y `name`. Respuestas: 200, 400, 401."
          }
        },
        {
          "name": "Login user",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('userToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@techstore.com\",\n  \"password\": \"User123!\"\n}" }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/auth/me",
            "description": "Perfil del usuario autenticado. Respuestas: 200, 401."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?category=audio&page=1&limit=6&sort=price_asc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "audio", "description": "Slug de categoría (opcional)" },
                { "key": "brand", "value": "", "description": "Id de marca (opcional)", "disabled": true },
                { "key": "search", "value": "", "description": "Texto en nombre o descripción (opcional)", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "6", "description": "1 a 50" },
                { "key": "sort", "value": "price_asc", "description": "newest | price_asc | price_desc | name" }
              ]
            },
            "description": "Público. Devuelve `{ data: Product[], pagination: { page, limit, total, totalPages } }`."
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Público. Respuestas: 200, 400 (id inválido), 404."
          }
        },
        {
          "name": "Create product (admin)",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('productId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"iPad Air M2\",\n  \"description\": \"Tablet de 11 pulgadas con chip M2.\",\n  \"price\": 14999,\n  \"stock\": 10,\n  \"image_url\": \"https://picsum.photos/seed/ipad-air/600/400\",\n  \"category_id\": 4,\n  \"brand_id\": 1\n}" },
            "description": "Solo admin. Respuestas: 201, 400 (validación o categoría/marca inexistente), 401, 403."
          }
        },
        {
          "name": "Update product (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/products/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"iPad Air M2 (2024)\",\n  \"description\": \"Tablet de 11 pulgadas con chip M2.\",\n  \"price\": 13999,\n  \"stock\": 8,\n  \"image_url\": \"https://picsum.photos/seed/ipad-air/600/400\",\n  \"category_id\": 4,\n  \"brand_id\": 1\n}" },
            "description": "Solo admin. Reemplaza el producto completo. Respuestas: 200, 400, 401, 403, 404."
          }
        },
        {
          "name": "Delete product (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Solo admin. Respuestas: 204, 401, 403, 404."
          }
        },
        {
          "name": "Create product as user (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": "{{baseUrl}}/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"No permitido\",\n  \"price\": 1,\n  \"stock\": 1,\n  \"category_id\": 1,\n  \"brand_id\": 1\n}" },
            "description": "Demuestra el control de acceso por rol: un usuario `user` recibe 403."
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "Categories", "request": { "method": "GET", "url": "{{baseUrl}}/categories", "description": "Público. Incluye `product_count` y `cover_image`." } },
        { "name": "Brands", "request": { "method": "GET", "url": "{{baseUrl}}/brands", "description": "Público. Incluye `product_count`." } },
        { "name": "Product images (admin)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/images", "description": "Solo admin. Imágenes locales disponibles (`path` para guardar en `image_url`, `url` para mostrarla). Respuestas: 200, 401, 403." } },
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Latest reviews",
          "request": { "method": "GET", "url": "{{baseUrl}}/reviews?limit=3", "description": "Público. Últimas reseñas con `user`, `product` (incluye `image_url`), `rating` y `comment`. `limit` de 1 a 20." }
        },
        {
          "name": "Reviews of a product",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}/reviews", "description": "Público. Respuestas: 200, 404." }
        },
        {
          "name": "Create review (user)",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('reviewId', pm.response.json().id);"] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": "{{baseUrl}}/products/{{productId}}/reviews",
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Excelente producto, llegó rápido.\"\n}" },
            "description": "Usuario autenticado. Una reseña por usuario y producto. Respuestas: 201, 400, 401, 404, 409 (duplicada)."
          }
        },
        {
          "name": "Delete review (author or admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/reviews/{{reviewId}}",
            "description": "Solo el autor de la reseña o un admin. Respuestas: 204, 401, 403, 404."
          }
        }
      ]
    }
  ]
}
